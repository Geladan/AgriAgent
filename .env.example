# ============================================================
# Agri AI configuration — copy this file to .env and fill in
# ============================================================

# --- AI provider: mock | openrouter | openai | openwork | omniroute | deepseek ---
# mock = built-in rule-based answers, no key needed, works offline
AI_PROVIDER=mock

# OpenRouter (free models available, e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenWork Cloud managed models (OpenAI-compatible)
OPENWORK_API_KEY=
OPENWORK_MODEL=gpt-4o-mini
OPENWORK_BASE_URL=https://api.openworklabs.com/v1

# OmniRoute — self-hosted AI gateway (default: local instance on port 20128)
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-chat
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# DeepSeek — prepaid OpenAI-compatible API (top up at platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Weather (free key: openweathermap.org, 1000 calls/day) ---
OPENWEATHER_API_KEY=

# --- Push channels (for scripts\push_brief.py) ---
# Twilio WhatsApp (twilio.com/try-twilio — sandbox number starts with whatsapp:+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Africa's Talking SMS fallback (africastalking.com)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- Database (defaults to local SQLite — no setup needed) ---
# DATABASE_URL=sqlite:///agri_ai.db
# DATABASE_URL=postgresql://user:pass@host:5432/db